# ─────────────────────────────────────────────────────────────────────────────
# Sudanese Heritage Platform — Environment Variables
# Copy this file to .env and fill in the values
# NEVER commit .env to version control
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
# Production: https://sudandna.com  |  Local dev: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="منصة التراث السوداني"

# ── Authentication (NextAuth) ─────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-32-char-secret-here
# Production: https://sudandna.com  |  Local dev: http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Get from: https://console.developers.google.com
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── PostgreSQL (Prisma) ───────────────────────────────────────────────────────
# Local:      postgresql://user:pass@localhost:5432/heritage_db
# DO Managed: postgresql://user:pass@host:port/database?sslmode=require
DATABASE_URL=postgresql://heritage_user:heritagepass@localhost:5432/heritage_db

# ── Neo4j Graph Database ──────────────────────────────────────────────────────
# Local:    bolt://localhost:7687
# AuraDB:   neo4j+s://xxxxx.databases.neo4j.io
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=heritagegraph

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://:redispass@localhost:6379
REDIS_PASSWORD=redispass

# ── AI Service ───────────────────────────────────────────────────────────────
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_API_KEY=dev-key-change-in-production

# ── Phase 3 LLM APIs (Optional) ──────────────────────────────────────────────
# Anthropic Claude (for narrative generation)
ANTHROPIC_API_KEY=

# OpenAI (alternative)
OPENAI_API_KEY=

# ── File Storage (DigitalOcean Spaces) ───────────────────────────────────────
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_ENDPOINT=https://fra1.digitaloceanspaces.com
DO_SPACES_BUCKET=heritage-uploads
DO_SPACES_REGION=fra1
NEXT_PUBLIC_CDN_URL=https://heritage-uploads.fra1.cdn.digitaloceanspaces.com

# ── Email (Optional - for notifications) ─────────────────────────────────────
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=
SMTP_FROM=noreply@sudandna.com

# ── Monitoring ────────────────────────────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_GA_ID=
