{
  "name": "sudanese-heritage-platform",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build && cp -r .next/static .next/standalone/.next/static && (cp -r public .next/standalone/public 2>/dev/null || true) && (pm2 restart heritage --update-env 2>/dev/null || true)",
    "start": "next start",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force && npm run db:seed",
    "ai:dev": "cd ai-service && uvicorn main:app --reload --port 8001"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.2.0",
